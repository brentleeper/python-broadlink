#!/usr/bin/env python3
"""Export trained .device files to JSON for the homebridge-broadlink-rf plugin.

Each .device file is a pickled {command_name: packet_bytes} dict written by
custom_device_creator. This writes one JSON file shaped like:

    {"office_fan": {"light_on": "<hex>", "speed1": "<hex>", ...}, ...}

Usage:
    export_custom_devices <custom_devices_dir> <output.json>

Only run this on .device files you created yourself: unpickling runs code.
"""
import json
import os
import pickle
import sys


def export(source_dir, output_path):
    devices = {}
    for file_name in sorted(os.listdir(source_dir)):
        if not file_name.endswith(".device"):
            continue
        name = file_name[: -len(".device")]
        with open(os.path.join(source_dir, file_name), "rb") as file:
            config = pickle.load(file)

        commands = {}
        for command, packet in config.items():
            if not isinstance(packet, (bytes, bytearray)):
                print(f"skipping {name}.{command}: packet is {type(packet).__name__}, not bytes")
                continue
            commands[command] = bytes(packet).hex()

        devices[name] = commands
        print(f"exported {name}: {', '.join(commands) or '(no commands)'}")

    if not devices:
        print(f"no .device files found in {source_dir}")
        return 1

    with open(output_path, "w") as file:
        json.dump(devices, file, indent=2)
    print(f"wrote {len(devices)} device(s) to {output_path}")
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 3:
        print(__doc__)
        sys.exit(2)
    sys.exit(export(sys.argv[1], sys.argv[2]))
